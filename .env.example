# Copy this file to .env.local for local development. Never commit the real file.

# DigitalOcean Serverless Inference model access key.
# Create one at: DO Control Panel -> Inference -> Serverless Inference -> Create model access key
MODEL_ACCESS_KEY=your_model_access_key_here

# Model slugs must be Serverless-eligible (check the "Availability" column in
# Model Catalog) and must use the exact API model ID from that model's
# "API Usage" tab -- the display name/slug in the table is not always the
# literal value the API expects.
CHEAP_MODEL=deepseek-v4-flash-0731
STRONG_MODEL=llama-4-maverick
